# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Anything prefixed VITE_ is compiled into the public JavaScript bundle and is
# readable by anyone. Never put a secret behind that prefix. Everything else in
# this file is server-side only.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string. A free Neon or Supabase instance is fine.
# Neon requires sslmode=require.
DATABASE_URL="postgresql://user:password@host:5432/safa_baitul_maal?sslmode=require"

# ---------------------------------------------------------------------------
# Server (required)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Origin the browser loads the site from. Used for CORS and cookie settings.
# In development this is the Vite dev server.
APP_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out. Must be at least 32 characters.
AUTH_SECRET=""

# The first administrator, created by `npm run db:seed`. Change the password
# immediately after the first login, and remove it from this file.
SEED_ADMIN_EMAIL="admin@safabaitulmaal.org"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Site Administrator"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Where the browser sends API requests. Leave empty in development: Vite
# proxies /api to the server, so a relative path works and there is no CORS.
VITE_API_BASE_URL=""

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
# Directory uploaded images and documents are written to, relative to the
# project root. Keep it outside the build output.
UPLOAD_DIR="uploads"
UPLOAD_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# Payments (optional until a provider is connected)
# ---------------------------------------------------------------------------
# Leave PAYMENT_PROVIDER empty and the donation flow keeps handing off to the
# organisation's existing donation platform, exactly as it does today.
# Set it to "razorpay" only once the keys below are real.
PAYMENT_PROVIDER=""
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
# Verifies webhook signatures. A webhook without a valid signature is rejected.
PAYMENT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Unset means notifications are logged, not sent. No email is ever sent
# silently without this configured.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="Safa Baitul Maal <info@safabaitulmaal.org>"
# Where new volunteer applications and contact messages are announced.
EMAIL_NOTIFY_TO=""
